# Copie este archivo a .env (que Git ignora) y cambie los valores.
DB_PASSWORD=cambie-esta-clave
# Al menos 32 caracteres; genere uno con:  openssl rand -hex 32
JWT_SECRET=
# true solo para cargar datos de demostración
SEED=false
# Solo para docker-compose.observabilidad.yml (Grafana). Sin valor por defecto a propósito:
GRAFANA_PASSWORD=
