{
 "uid": "taskflow-endpoint",
 "title": "TaskFlow — endpoint crítico PATCH /api/tareas/{id}/estado",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "10s",
 "tags": [
  "taskflow",
  "sre"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Tasa de peticiones (req/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/tareas/{id}/estado\"}[1m]))",
     "legendFormat": "req/s"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Latencia p95 (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/tareas/{id}/estado\"}[1m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Errores del servidor, % (5xx)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum(rate(http_server_requests_seconds_count{uri=\"/api/tareas/{id}/estado\",status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{uri=\"/api/tareas/{id}/estado\"}[1m]))",
     "legendFormat": "5xx %"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Resultado de los cambios de estado (por segundo)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (resultado) (rate(taskflow_cambios_estado_total[1m]))",
     "legendFormat": "{{resultado}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Peticiones por código HTTP (req/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri=\"/api/tareas/{id}/estado\"}[1m]))",
     "legendFormat": "{{status}}"
    }
   ]
  }
 ]
}